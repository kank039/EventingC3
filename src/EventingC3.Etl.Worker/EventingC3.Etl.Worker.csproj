<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Throughput-oriented GC: one heap per core, background collections. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventingC3.Etl.Infrastructure\EventingC3.Etl.Infrastructure.csproj" />
  </ItemGroup>

</Project>
