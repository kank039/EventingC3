{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Etl": {
    "Source": "Kafka",
    "DeadLetter": "Kafka",
    "Pipeline": {
      "MaxBatchRecords": 100000,
      "MaxBatchBytes": 67108864,
      "MaxBatchLatency": "00:00:02",
      "RecordBufferCapacity": 200000,
      "MaxConcurrentBatches": 4,
      "RetryInitialDelay": "00:00:00.200",
      "RetryMaxDelay": "00:00:30",
      "UnhealthyAfterConsecutiveFailures": 5,
      "ShutdownGracePeriod": "00:00:25"
    },
    "Transform": {
      "MaxRecordBytes": 65536,
      "MaxEventAge": "30.00:00:00",
      "MaxFutureSkew": "01:00:00",
      "DefaultUtcOffset": "02:00:00"
    },
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "Topic": "tracking-events",
      "GroupId": "eventingc3-etl",
      "CommitInterval": "00:00:01",
      "ConsumerConfig": {}
    },
    "DeadLetterKafka": {
      "Topic": "tracking-events.dlq"
    },
    "Files": {
      "InputDirectory": "./data/inbox",
      "ProcessedDirectory": "./data/processed",
      "SearchPattern": "*.ndjson*",
      "StopWhenIdle": false
    },
    "DeadLetterFiles": {
      "Directory": "./data/dlq"
    },
    "ClickHouse": {
      "Endpoint": "http://localhost:8123",
      "Database": "eventing",
      "Table": "tracking_events",
      "Username": "default",
      "Password": "",
      "Compression": "none",
      "ApplySchemaOnStartup": true
    }
  }
}
